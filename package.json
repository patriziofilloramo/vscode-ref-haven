{
  "name": "branch-compare",
  "displayName": "Branch Compare",
  "description": "Persistent, directional comparisons between Git branches.",
  "version": "0.1.0",
  "publisher": "local-development",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20 <21",
    "vscode": "^1.105.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "files": [
    "dist/**"
  ],
  "contributes": {
    "commands": [
      {
        "command": "branchCompare.newComparison",
        "title": "New Comparison",
        "category": "Branch Compare",
        "icon": "$(add)"
      },
      {
        "command": "branchCompare.compareCurrentBranch",
        "title": "Compare Current Branch With...",
        "category": "Branch Compare"
      },
      {
        "command": "branchCompare.refreshAll",
        "title": "Refresh All Comparisons",
        "category": "Branch Compare",
        "icon": "$(refresh)"
      },
      {
        "command": "branchCompare.refreshComparison",
        "title": "Refresh Comparison",
        "category": "Branch Compare",
        "icon": "$(refresh)"
      },
      {
        "command": "branchCompare.swapComparison",
        "title": "Swap Base and Target",
        "category": "Branch Compare",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "branchCompare.pinComparison",
        "title": "Pin Comparison",
        "category": "Branch Compare",
        "icon": "$(pin)"
      },
      {
        "command": "branchCompare.unpinComparison",
        "title": "Unpin Comparison",
        "category": "Branch Compare",
        "icon": "$(pinned)"
      },
      {
        "command": "branchCompare.closeComparison",
        "title": "Close Comparison",
        "category": "Branch Compare",
        "icon": "$(close)"
      },
      {
        "command": "branchCompare.copyComparisonSummary",
        "title": "Copy Summary",
        "category": "Branch Compare"
      },
      {
        "command": "branchCompare.copyCommitSha",
        "title": "Copy Commit SHA",
        "category": "Branch Compare"
      },
      {
        "command": "branchCompare.viewFilesAsList",
        "title": "View Changed Files as List",
        "category": "Branch Compare",
        "icon": "$(list-flat)"
      },
      {
        "command": "branchCompare.viewFilesAsTree",
        "title": "View Changed Files as Tree",
        "category": "Branch Compare",
        "icon": "$(list-tree)"
      },
      {
        "command": "branchCompare.copyCommitMessage",
        "title": "Copy Commit Message",
        "category": "Branch Compare"
      },
      {
        "command": "branchCompare.openFile",
        "title": "Open File",
        "category": "Branch Compare",
        "icon": "$(go-to-file)"
      },
      {
        "command": "branchCompare.copyFilePath",
        "title": "Copy Path",
        "category": "Branch Compare"
      },
      {
        "command": "branchCompare.copyRelativeFilePath",
        "title": "Copy Relative Path",
        "category": "Branch Compare"
      },
      {
        "command": "branchCompare.stashAllChanges",
        "title": "Stash All Changes",
        "category": "Branch Compare",
        "icon": "$(add)"
      },
      {
        "command": "branchCompare.refreshStashes",
        "title": "Refresh Stashes",
        "category": "Branch Compare",
        "icon": "$(refresh)"
      },
      {
        "command": "branchCompare.applyStash",
        "title": "Apply Stash",
        "category": "Branch Compare",
        "icon": "$(git-stash-apply)"
      },
      {
        "command": "branchCompare.popStash",
        "title": "Pop Stash (Apply and Drop)",
        "category": "Branch Compare",
        "icon": "$(git-stash-pop)"
      },
      {
        "command": "branchCompare.dropStash",
        "title": "Drop Stash",
        "category": "Branch Compare",
        "icon": "$(trash)"
      },
      {
        "command": "branchCompare.copyStashMessage",
        "title": "Copy Stash Message",
        "category": "Branch Compare"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "branchCompare.comparisons",
          "name": "Branch Comparisons"
        },
        {
          "id": "branchCompare.stashes",
          "name": "Stashes"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "branchCompare.comparisons",
        "contents": "No branch comparisons yet.\n[New Comparison](command:branchCompare.newComparison)\nCompare any two branches and keep the comparison across reloads."
      },
      {
        "view": "branchCompare.stashes",
        "contents": "No stashes in this workspace.\n[Stash All Changes](command:branchCompare.stashAllChanges)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "branchCompare.refreshComparison",
          "when": "false"
        },
        {
          "command": "branchCompare.swapComparison",
          "when": "false"
        },
        {
          "command": "branchCompare.pinComparison",
          "when": "false"
        },
        {
          "command": "branchCompare.unpinComparison",
          "when": "false"
        },
        {
          "command": "branchCompare.closeComparison",
          "when": "false"
        },
        {
          "command": "branchCompare.copyComparisonSummary",
          "when": "false"
        },
        {
          "command": "branchCompare.copyCommitSha",
          "when": "false"
        },
        {
          "command": "branchCompare.copyCommitMessage",
          "when": "false"
        },
        {
          "command": "branchCompare.openFile",
          "when": "false"
        },
        {
          "command": "branchCompare.copyFilePath",
          "when": "false"
        },
        {
          "command": "branchCompare.copyRelativeFilePath",
          "when": "false"
        },
        {
          "command": "branchCompare.applyStash",
          "when": "false"
        },
        {
          "command": "branchCompare.popStash",
          "when": "false"
        },
        {
          "command": "branchCompare.dropStash",
          "when": "false"
        },
        {
          "command": "branchCompare.copyStashMessage",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "branchCompare.newComparison",
          "when": "view == branchCompare.comparisons",
          "group": "navigation@1"
        },
        {
          "command": "branchCompare.viewFilesAsTree",
          "when": "view == branchCompare.comparisons && branchCompare.filesLayout == list",
          "group": "navigation@2"
        },
        {
          "command": "branchCompare.viewFilesAsList",
          "when": "view == branchCompare.comparisons && branchCompare.filesLayout == tree",
          "group": "navigation@2"
        },
        {
          "command": "branchCompare.refreshAll",
          "when": "view == branchCompare.comparisons",
          "group": "navigation@3"
        },
        {
          "command": "branchCompare.stashAllChanges",
          "when": "view == branchCompare.stashes",
          "group": "navigation@1"
        },
        {
          "command": "branchCompare.refreshStashes",
          "when": "view == branchCompare.stashes",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "branchCompare.refreshComparison",
          "when": "view == branchCompare.comparisons && viewItem =~ /^branchCompare\\.comparison/",
          "group": "inline@1"
        },
        {
          "command": "branchCompare.swapComparison",
          "when": "view == branchCompare.comparisons && viewItem =~ /^branchCompare\\.comparison/",
          "group": "inline@2"
        },
        {
          "command": "branchCompare.pinComparison",
          "when": "view == branchCompare.comparisons && viewItem == branchCompare.comparison",
          "group": "inline@3"
        },
        {
          "command": "branchCompare.unpinComparison",
          "when": "view == branchCompare.comparisons && viewItem == branchCompare.comparisonPinned",
          "group": "inline@3"
        },
        {
          "command": "branchCompare.closeComparison",
          "when": "view == branchCompare.comparisons && viewItem =~ /^branchCompare\\.comparison/",
          "group": "inline@4"
        },
        {
          "command": "branchCompare.refreshComparison",
          "when": "view == branchCompare.comparisons && viewItem =~ /^branchCompare\\.comparison/",
          "group": "1_actions@1"
        },
        {
          "command": "branchCompare.swapComparison",
          "when": "view == branchCompare.comparisons && viewItem =~ /^branchCompare\\.comparison/",
          "group": "1_actions@2"
        },
        {
          "command": "branchCompare.copyComparisonSummary",
          "when": "view == branchCompare.comparisons && viewItem =~ /^branchCompare\\.comparison/",
          "group": "2_copy@1"
        },
        {
          "command": "branchCompare.closeComparison",
          "when": "view == branchCompare.comparisons && viewItem =~ /^branchCompare\\.comparison/",
          "group": "3_close@1"
        },
        {
          "command": "branchCompare.copyCommitSha",
          "when": "view == branchCompare.comparisons && viewItem == branchCompare.commit",
          "group": "2_copy@1"
        },
        {
          "command": "branchCompare.copyCommitMessage",
          "when": "view == branchCompare.comparisons && viewItem == branchCompare.commit",
          "group": "2_copy@2"
        },
        {
          "command": "branchCompare.openFile",
          "when": "(view == branchCompare.comparisons || view == branchCompare.stashes) && viewItem =~ /^branchCompare\\.file/",
          "group": "1_open@1"
        },
        {
          "command": "branchCompare.copyFilePath",
          "when": "(view == branchCompare.comparisons || view == branchCompare.stashes) && viewItem =~ /^branchCompare\\.file/",
          "group": "2_copy@1"
        },
        {
          "command": "branchCompare.copyRelativeFilePath",
          "when": "(view == branchCompare.comparisons || view == branchCompare.stashes) && viewItem =~ /^branchCompare\\.file/",
          "group": "2_copy@2"
        },
        {
          "command": "branchCompare.applyStash",
          "when": "view == branchCompare.stashes && viewItem == branchCompare.stash",
          "group": "inline@1"
        },
        {
          "command": "branchCompare.popStash",
          "when": "view == branchCompare.stashes && viewItem == branchCompare.stash",
          "group": "inline@2"
        },
        {
          "command": "branchCompare.dropStash",
          "when": "view == branchCompare.stashes && viewItem == branchCompare.stash",
          "group": "inline@3"
        },
        {
          "command": "branchCompare.applyStash",
          "when": "view == branchCompare.stashes && viewItem == branchCompare.stash",
          "group": "1_actions@1"
        },
        {
          "command": "branchCompare.popStash",
          "when": "view == branchCompare.stashes && viewItem == branchCompare.stash",
          "group": "1_actions@2"
        },
        {
          "command": "branchCompare.dropStash",
          "when": "view == branchCompare.stashes && viewItem == branchCompare.stash",
          "group": "1_actions@3"
        },
        {
          "command": "branchCompare.copyStashMessage",
          "when": "view == branchCompare.stashes && viewItem == branchCompare.stash",
          "group": "2_copy@1"
        }
      ]
    }
  },
  "scripts": {
    "clean": "rimraf dist .test-out .vscode-test branch-compare-*.vsix",
    "compile": "tsc -p tsconfig.json",
    "compile:tests": "tsc -p test/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test scripts *.mjs --max-warnings 0",
    "test": "npm run test:unit",
    "test:unit": "npm run compile:tests && mocha --ui tdd \".test-out/test/unit/**/*.test.js\"",
    "test:extension": "npm run compile && npm run compile:tests && vscode-test",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license --out branch-compare-0.1.0.vsix"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "1.105.0",
    "@vscode/test-cli": "0.0.11",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.9.2",
    "eslint": "10.7.0",
    "mocha": "11.3.0",
    "prettier": "3.9.5",
    "rimraf": "6.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  }
}

{
  "name": "refhaven",
  "displayName": "RefHaven",
  "description": "Private Git comparisons, history, blame, and stash inspection — entirely local.",
  "version": "0.4.0",
  "publisher": "local-development",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20 <21",
    "vscode": "^1.105.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "files": [
    "dist/**/*.js",
    "SECURITY.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "refhaven.newComparison",
        "title": "New Comparison",
        "category": "RefHaven",
        "icon": "$(add)"
      },
      {
        "command": "refhaven.compareCurrentBranch",
        "title": "Compare Current Branch With...",
        "category": "RefHaven"
      },
      {
        "command": "refhaven.compareBranchWithCurrent",
        "title": "Compare with Current Branch",
        "category": "RefHaven",
        "icon": "$(git-compare)"
      },
      {
        "command": "refhaven.copyBranchName",
        "title": "Copy Branch Name",
        "category": "RefHaven"
      },
      {
        "command": "refhaven.refreshAll",
        "title": "Refresh All Comparisons",
        "category": "RefHaven",
        "icon": "$(refresh)"
      },
      {
        "command": "refhaven.refreshComparison",
        "title": "Refresh Comparison",
        "category": "RefHaven",
        "icon": "$(refresh)"
      },
      {
        "command": "refhaven.swapComparison",
        "title": "Swap Base and Target",
        "category": "RefHaven",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "refhaven.changeComparisonMode",
        "title": "Change Comparison Mode...",
        "category": "RefHaven",
        "icon": "$(git-compare)"
      },
      {
        "command": "refhaven.changeFileAnnotations",
        "title": "Change File Annotations...",
        "category": "RefHaven",
        "icon": "$(symbol-color)"
      },
      {
        "command": "refhaven.compareFileWithRevision",
        "title": "Compare File with Revision...",
        "category": "RefHaven",
        "icon": "$(compare-changes)"
      },
      {
        "command": "refhaven.stashFile",
        "title": "Stash This File...",
        "category": "RefHaven",
        "icon": "$(git-stash)"
      },
      {
        "command": "refhaven.compareStashFileWithHead",
        "title": "Compare Stash File with HEAD",
        "category": "RefHaven",
        "icon": "$(compare-changes)"
      },
      {
        "command": "refhaven.compareStashFileWithWorkingTree",
        "title": "Compare Stash File with Working Tree",
        "category": "RefHaven",
        "icon": "$(compare-changes)"
      },
      {
        "command": "refhaven.findOtherStashesContainingFile",
        "title": "Find Other Stashes Containing File",
        "category": "RefHaven",
        "icon": "$(search)"
      },
      {
        "command": "refhaven.openStashFileAtRevision",
        "title": "Open at Stash Revision",
        "category": "RefHaven",
        "icon": "$(go-to-file)"
      },
      {
        "command": "refhaven.pinComparison",
        "title": "Pin Comparison",
        "category": "RefHaven",
        "icon": "$(pin)"
      },
      {
        "command": "refhaven.unpinComparison",
        "title": "Unpin Comparison",
        "category": "RefHaven",
        "icon": "$(pinned)"
      },
      {
        "command": "refhaven.closeComparison",
        "title": "Close Comparison",
        "category": "RefHaven",
        "icon": "$(close)"
      },
      {
        "command": "refhaven.copyComparisonSummary",
        "title": "Copy Summary",
        "category": "RefHaven"
      },
      {
        "command": "refhaven.copyCommitSha",
        "title": "Copy Commit SHA",
        "category": "RefHaven"
      },
      {
        "command": "refhaven.viewFilesAsList",
        "title": "View Changed Files as List",
        "category": "RefHaven",
        "icon": "$(list-flat)"
      },
      {
        "command": "refhaven.viewFilesAsTree",
        "title": "View Changed Files as Tree",
        "category": "RefHaven",
        "icon": "$(list-tree)"
      },
      {
        "command": "refhaven.copyCommitMessage",
        "title": "Copy Commit Message",
        "category": "RefHaven"
      },
      {
        "command": "refhaven.openFile",
        "title": "Open File",
        "category": "RefHaven",
        "icon": "$(go-to-file)"
      },
      {
        "command": "refhaven.openChangedFileAtRevision",
        "title": "Open File at Compared Revision",
        "category": "RefHaven",
        "icon": "$(history)"
      },
      {
        "command": "refhaven.copyFilePath",
        "title": "Copy Path",
        "category": "RefHaven"
      },
      {
        "command": "refhaven.copyRelativeFilePath",
        "title": "Copy Relative Path",
        "category": "RefHaven"
      },
      {
        "command": "refhaven.refreshStashes",
        "title": "Refresh Stashes",
        "category": "RefHaven",
        "icon": "$(refresh)"
      },
      {
        "command": "refhaven.copyStashMessage",
        "title": "Copy Stash Message",
        "category": "RefHaven"
      },
      {
        "command": "refhaven.openFileAtRevision",
        "title": "Open File at Revision...",
        "category": "RefHaven",
        "icon": "$(history)"
      },
      {
        "command": "refhaven.toggleInlineBlame",
        "title": "Toggle Inline Blame",
        "category": "RefHaven"
      },
      {
        "command": "refhaven.showLineBlameActions",
        "title": "Show Line Blame Actions",
        "category": "RefHaven"
      },
      {
        "command": "refhaven.refreshFileHistory",
        "title": "Refresh File History",
        "category": "RefHaven",
        "icon": "$(refresh)"
      },
      {
        "command": "refhaven.showLineHistory",
        "title": "Show Line History",
        "category": "RefHaven"
      },
      {
        "command": "refhaven.openFileHistoryDiff",
        "title": "Open File Change",
        "category": "RefHaven",
        "icon": "$(compare-changes)"
      },
      {
        "command": "refhaven.openFileHistoryAtRevision",
        "title": "Open File at This Revision",
        "category": "RefHaven",
        "icon": "$(go-to-file)"
      },
      {
        "command": "refhaven.openLineDiff",
        "title": "Open Line Commit Diff",
        "category": "RefHaven",
        "icon": "$(compare-changes)"
      },
      {
        "command": "refhaven.searchCommits",
        "title": "Search Commits",
        "category": "RefHaven",
        "icon": "$(search)"
      },
      {
        "command": "refhaven.showCommitDetails",
        "title": "Show Commit Details",
        "category": "RefHaven",
        "icon": "$(inspect)"
      },
      {
        "command": "refhaven.showFileHistory",
        "title": "Show File History",
        "category": "RefHaven",
        "icon": "$(history)"
      },
      {
        "command": "refhaven.showRefHavenMenu",
        "title": "Show File Actions",
        "category": "RefHaven",
        "icon": "$(git-compare)"
      },
      {
        "command": "refhaven.refreshRepositoryNavigation",
        "title": "Refresh Branches and Worktrees",
        "category": "RefHaven",
        "icon": "$(refresh)"
      },
      {
        "command": "refhaven.openWorktree",
        "title": "Open Worktree in New Window",
        "category": "RefHaven",
        "icon": "$(link-external)"
      },
      {
        "command": "refhaven.copyWorktreePath",
        "title": "Copy Worktree Path",
        "category": "RefHaven"
      }
    ],
    "configuration": {
      "title": "RefHaven",
      "properties": {
        "refhaven.inlineBlame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show blame for the current line as dimmed inline text at the end of the line."
        },
        "refhaven.statusBarBlame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show blame for the current line in the status bar."
        },
        "refhaven.lineHover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show rich local commit and diff details when hovering a file line."
        },
        "refhaven.fileAnnotations.mode": {
          "type": "string",
          "enum": [
            "off",
            "blame",
            "heatmap"
          ],
          "enumDescriptions": [
            "Do not annotate the whole file.",
            "Show blame markers and hovers for every line.",
            "Color lines by the age of their last commit."
          ],
          "default": "off",
          "description": "Whole-file annotation mode. Changes-relative-to-ref annotations are selected per session from the command palette."
        },
        "refhaven.git.timeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 300,
          "description": "Maximum duration in seconds for an individual Git command."
        }
      }
    },
    "submenus": [
      {
        "id": "refhaven.fileActions",
        "label": "RefHaven"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "refhaven.comparisons",
          "name": "Branch Comparisons"
        },
        {
          "id": "refhaven.stashes",
          "name": "Stashes"
        },
        {
          "id": "refhaven.fileHistory",
          "name": "File History"
        },
        {
          "id": "refhaven.commitDetails",
          "name": "Commit Details"
        },
        {
          "id": "refhaven.branches",
          "name": "Branches"
        },
        {
          "id": "refhaven.worktrees",
          "name": "Worktrees"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "refhaven.comparisons",
        "contents": "No branch comparisons yet.\n[New Comparison](command:refhaven.newComparison)\nCompare any two branches and keep the comparison across reloads."
      },
      {
        "view": "refhaven.stashes",
        "contents": "No stashes in this workspace."
      },
      {
        "view": "refhaven.fileHistory",
        "contents": "Open a tracked file to view its history."
      },
      {
        "view": "refhaven.commitDetails",
        "contents": "Select **Show Commit Details** from a commit or use [Search Commits](command:refhaven.searchCommits)."
      },
      {
        "view": "refhaven.branches",
        "contents": "No local or remote-tracking branches found."
      },
      {
        "view": "refhaven.worktrees",
        "contents": "No worktrees found."
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "refhaven.refreshComparison",
          "when": "false"
        },
        {
          "command": "refhaven.swapComparison",
          "when": "false"
        },
        {
          "command": "refhaven.changeComparisonMode",
          "when": "false"
        },
        {
          "command": "refhaven.pinComparison",
          "when": "false"
        },
        {
          "command": "refhaven.unpinComparison",
          "when": "false"
        },
        {
          "command": "refhaven.closeComparison",
          "when": "false"
        },
        {
          "command": "refhaven.copyComparisonSummary",
          "when": "false"
        },
        {
          "command": "refhaven.copyCommitSha",
          "when": "false"
        },
        {
          "command": "refhaven.copyCommitMessage",
          "when": "false"
        },
        {
          "command": "refhaven.openFile",
          "when": "false"
        },
        {
          "command": "refhaven.copyFilePath",
          "when": "false"
        },
        {
          "command": "refhaven.copyRelativeFilePath",
          "when": "false"
        },
        {
          "command": "refhaven.copyStashMessage",
          "when": "false"
        },
        {
          "command": "refhaven.openFileHistoryDiff",
          "when": "false"
        },
        {
          "command": "refhaven.openFileHistoryAtRevision",
          "when": "false"
        },
        {
          "command": "refhaven.showCommitDetails",
          "when": "false"
        },
        {
          "command": "refhaven.compareBranchWithCurrent",
          "when": "false"
        },
        {
          "command": "refhaven.copyBranchName",
          "when": "false"
        },
        {
          "command": "refhaven.openWorktree",
          "when": "false"
        },
        {
          "command": "refhaven.copyWorktreePath",
          "when": "false"
        },
        {
          "command": "refhaven.openChangedFileAtRevision",
          "when": "false"
        },
        {
          "command": "refhaven.openLineDiff",
          "when": "false"
        },
        {
          "command": "refhaven.compareStashFileWithHead",
          "when": "false"
        },
        {
          "command": "refhaven.compareStashFileWithWorkingTree",
          "when": "false"
        },
        {
          "command": "refhaven.findOtherStashesContainingFile",
          "when": "false"
        },
        {
          "command": "refhaven.openStashFileAtRevision",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "refhaven.newComparison",
          "when": "view == refhaven.comparisons",
          "group": "navigation@1"
        },
        {
          "command": "refhaven.viewFilesAsTree",
          "when": "view == refhaven.comparisons && refhaven.filesLayout == list",
          "group": "navigation@2"
        },
        {
          "command": "refhaven.viewFilesAsList",
          "when": "view == refhaven.comparisons && refhaven.filesLayout == tree",
          "group": "navigation@2"
        },
        {
          "command": "refhaven.refreshAll",
          "when": "view == refhaven.comparisons",
          "group": "navigation@3"
        },
        {
          "command": "refhaven.refreshStashes",
          "when": "view == refhaven.stashes",
          "group": "navigation@1"
        },
        {
          "command": "refhaven.refreshFileHistory",
          "when": "view == refhaven.fileHistory",
          "group": "navigation@1"
        },
        {
          "command": "refhaven.refreshRepositoryNavigation",
          "when": "view == refhaven.branches || view == refhaven.worktrees",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "refhaven.refreshComparison",
          "when": "view == refhaven.comparisons && viewItem =~ /^refhaven\\.comparison/",
          "group": "inline@1"
        },
        {
          "command": "refhaven.swapComparison",
          "when": "view == refhaven.comparisons && viewItem =~ /^refhaven\\.comparison/",
          "group": "inline@2"
        },
        {
          "command": "refhaven.pinComparison",
          "when": "view == refhaven.comparisons && viewItem == refhaven.comparison",
          "group": "inline@3"
        },
        {
          "command": "refhaven.unpinComparison",
          "when": "view == refhaven.comparisons && viewItem == refhaven.comparisonPinned",
          "group": "inline@3"
        },
        {
          "command": "refhaven.closeComparison",
          "when": "view == refhaven.comparisons && viewItem =~ /^refhaven\\.comparison/",
          "group": "inline@4"
        },
        {
          "command": "refhaven.refreshComparison",
          "when": "view == refhaven.comparisons && viewItem =~ /^refhaven\\.comparison/",
          "group": "1_actions@1"
        },
        {
          "command": "refhaven.swapComparison",
          "when": "view == refhaven.comparisons && viewItem =~ /^refhaven\\.comparison/",
          "group": "1_actions@2"
        },
        {
          "command": "refhaven.changeComparisonMode",
          "when": "view == refhaven.comparisons && viewItem =~ /^refhaven\\.comparison/",
          "group": "1_actions@3"
        },
        {
          "command": "refhaven.copyComparisonSummary",
          "when": "view == refhaven.comparisons && viewItem =~ /^refhaven\\.comparison/",
          "group": "2_copy@1"
        },
        {
          "command": "refhaven.closeComparison",
          "when": "view == refhaven.comparisons && viewItem =~ /^refhaven\\.comparison/",
          "group": "3_close@1"
        },
        {
          "command": "refhaven.copyCommitSha",
          "when": "view == refhaven.comparisons && viewItem == refhaven.commit",
          "group": "2_copy@1"
        },
        {
          "command": "refhaven.copyCommitMessage",
          "when": "view == refhaven.comparisons && viewItem == refhaven.commit",
          "group": "2_copy@2"
        },
        {
          "command": "refhaven.showCommitDetails",
          "when": "view == refhaven.comparisons && viewItem == refhaven.commit",
          "group": "1_actions@1"
        },
        {
          "command": "refhaven.openFile",
          "when": "(view == refhaven.comparisons || view == refhaven.stashes || view == refhaven.commitDetails) && viewItem =~ /^refhaven\\.file/",
          "group": "1_open@1"
        },
        {
          "command": "refhaven.openChangedFileAtRevision",
          "when": "(view == refhaven.comparisons || view == refhaven.commitDetails) && viewItem =~ /^refhaven\\.file/",
          "group": "1_open@2"
        },
        {
          "command": "refhaven.openStashFileAtRevision",
          "when": "view == refhaven.stashes && viewItem =~ /^refhaven\\.file/",
          "group": "1_open@2"
        },
        {
          "command": "refhaven.showFileHistory",
          "when": "(view == refhaven.comparisons || view == refhaven.stashes || view == refhaven.commitDetails) && viewItem =~ /^refhaven\\.file/",
          "group": "1_open@3"
        },
        {
          "command": "refhaven.copyFilePath",
          "when": "(view == refhaven.comparisons || view == refhaven.stashes || view == refhaven.commitDetails) && viewItem =~ /^refhaven\\.file/",
          "group": "2_copy@1"
        },
        {
          "command": "refhaven.copyRelativeFilePath",
          "when": "(view == refhaven.comparisons || view == refhaven.stashes || view == refhaven.commitDetails) && viewItem =~ /^refhaven\\.file/",
          "group": "2_copy@2"
        },
        {
          "command": "refhaven.compareStashFileWithHead",
          "when": "view == refhaven.stashes && viewItem =~ /^refhaven\\.file/",
          "group": "1_open@4"
        },
        {
          "command": "refhaven.compareStashFileWithWorkingTree",
          "when": "view == refhaven.stashes && viewItem =~ /^refhaven\\.file/",
          "group": "1_open@5"
        },
        {
          "command": "refhaven.findOtherStashesContainingFile",
          "when": "view == refhaven.stashes && viewItem =~ /^refhaven\\.file/",
          "group": "1_open@6"
        },
        {
          "command": "refhaven.copyStashMessage",
          "when": "view == refhaven.stashes && viewItem == refhaven.stash",
          "group": "2_copy@1"
        },
        {
          "command": "refhaven.openFileHistoryDiff",
          "when": "view == refhaven.fileHistory && viewItem == refhaven.fileHistoryCommit",
          "group": "1_open@1"
        },
        {
          "command": "refhaven.openFileHistoryAtRevision",
          "when": "view == refhaven.fileHistory && viewItem == refhaven.fileHistoryCommit",
          "group": "1_open@2"
        },
        {
          "command": "refhaven.copyCommitSha",
          "when": "view == refhaven.fileHistory && viewItem == refhaven.fileHistoryCommit",
          "group": "2_copy@1"
        },
        {
          "command": "refhaven.copyCommitMessage",
          "when": "view == refhaven.fileHistory && viewItem == refhaven.fileHistoryCommit",
          "group": "2_copy@2"
        },
        {
          "command": "refhaven.showCommitDetails",
          "when": "view == refhaven.fileHistory && viewItem == refhaven.fileHistoryCommit",
          "group": "1_open@3"
        },
        {
          "command": "refhaven.compareBranchWithCurrent",
          "when": "view == refhaven.branches && viewItem == refhaven.branch",
          "group": "inline@1"
        },
        {
          "command": "refhaven.compareBranchWithCurrent",
          "when": "view == refhaven.branches && viewItem == refhaven.branch",
          "group": "1_actions@1"
        },
        {
          "command": "refhaven.copyBranchName",
          "when": "view == refhaven.branches && viewItem =~ /^refhaven\\.branch/",
          "group": "2_copy@1"
        },
        {
          "command": "refhaven.openWorktree",
          "when": "view == refhaven.worktrees && viewItem == refhaven.worktree",
          "group": "inline@1"
        },
        {
          "command": "refhaven.openWorktree",
          "when": "view == refhaven.worktrees && viewItem == refhaven.worktree",
          "group": "1_actions@1"
        },
        {
          "command": "refhaven.copyWorktreePath",
          "when": "view == refhaven.worktrees && viewItem == refhaven.worktree",
          "group": "2_copy@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "refhaven.fileActions",
          "when": "resourceScheme == file",
          "group": "navigation@19"
        }
      ],
      "editor/title": [
        {
          "command": "refhaven.showRefHavenMenu",
          "when": "resourceScheme == file",
          "group": "navigation@20"
        }
      ],
      "explorer/context": [
        {
          "submenu": "refhaven.fileActions",
          "when": "resourceScheme == file",
          "group": "navigation@19"
        }
      ],
      "scm/resourceState/context": [
        {
          "submenu": "refhaven.fileActions",
          "when": "scmProvider == git",
          "group": "navigation@19"
        }
      ],
      "refhaven.fileActions": [
        {
          "command": "refhaven.showFileHistory",
          "when": "resourceScheme == file",
          "group": "1_history@1"
        },
        {
          "command": "refhaven.showLineHistory",
          "when": "resourceScheme == file && editorTextFocus",
          "group": "1_history@2"
        },
        {
          "command": "refhaven.openFileAtRevision",
          "when": "resourceScheme == file",
          "group": "2_revision@1"
        },
        {
          "command": "refhaven.compareFileWithRevision",
          "when": "resourceScheme == file",
          "group": "2_revision@2"
        },
        {
          "command": "refhaven.changeFileAnnotations",
          "when": "resourceScheme == file",
          "group": "3_annotations@1"
        },
        {
          "command": "refhaven.stashFile",
          "when": "resourceScheme == file || scmProvider == git",
          "group": "4_stash@1"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "tsc -p tsconfig.json",
    "compile:tests": "tsc -p test/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test scripts *.mjs --max-warnings 0",
    "test": "npm run test:unit",
    "test:unit": "npm run compile:tests && mocha --ui tdd \".test-out/test/unit/**/*.test.js\"",
    "test:extension": "npm run compile && npm run compile:tests && node scripts/run-extension-tests.mjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "1.105.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.9.2",
    "eslint": "10.7.0",
    "mocha": "11.3.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0"
  },
  "overrides": {
    "serialize-javascript": "7.0.7"
  }
}
